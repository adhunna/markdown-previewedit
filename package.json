{
  "name": "markdown-previewedit",
  "displayName": "Markdown PreviewEdit",
  "description": "Preview and edit Markdown in VS Code: Mermaid diagrams, GitHub alerts, formatting from the preview, and Word/PDF/HTML export. Offline, no telemetry.",
  "version": "0.3.1",
  "publisher": "adhunna",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a4fb5",
    "theme": "dark"
  },
  "preview": true,
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/adhunna/markdown-previewedit.git"
  },
  "bugs": {
    "url": "https://github.com/adhunna/markdown-previewedit/issues"
  },
  "homepage": "https://github.com/adhunna/markdown-previewedit#readme",
  "qna": "https://github.com/adhunna/markdown-previewedit/issues",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "github alerts",
    "word",
    "docx",
    "pdf",
    "html export",
    "formatting",
    "katex",
    "diagrams"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:markdown.preview",
    "onWebviewPanel:previewEdit.editPreview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Export to PDF starts a local browser and is disabled in Restricted Mode.",
      "restrictedConfigurations": [
        "previewEdit.export.browserPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Export needs files on disk."
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/preview/mermaid.js"
    ],
    "markdown.previewStyles": [
      "./media/mdp-preview.css"
    ],
    "commands": [
      {
        "command": "previewEdit.exportDocx",
        "title": "Export to Word (.docx)",
        "category": "PreviewEdit"
      },
      {
        "command": "previewEdit.exportPdf",
        "title": "Export to PDF",
        "category": "PreviewEdit"
      },
      {
        "command": "previewEdit.exportHtml",
        "title": "Export to HTML",
        "category": "PreviewEdit"
      },
      {
        "command": "previewEdit.openPreview",
        "title": "Open Full Preview",
        "category": "PreviewEdit",
        "icon": "$(preview)"
      },
      {
        "command": "previewEdit.openPreviewToSide",
        "title": "Open Split Preview",
        "category": "PreviewEdit",
        "icon": "$(open-preview)"
      },
      {
        "command": "previewEdit.openEditPreview",
        "title": "Open Edit Preview (format from preview)",
        "category": "PreviewEdit",
        "icon": "$(edit)"
      },
      {
        "command": "previewEdit.preview.increaseFontSize",
        "title": "Increase Preview Font Size",
        "category": "PreviewEdit",
        "icon": "$(zoom-in)"
      },
      {
        "command": "previewEdit.preview.decreaseFontSize",
        "title": "Decrease Preview Font Size",
        "category": "PreviewEdit",
        "icon": "$(zoom-out)"
      },
      {
        "command": "previewEdit.preview.resetFontSize",
        "title": "Reset Preview Font Size",
        "category": "PreviewEdit"
      },
      {
        "command": "previewEdit.preview.toggleTheme",
        "title": "Toggle Preview Theme (Auto / Light / Dark)",
        "category": "PreviewEdit",
        "icon": "$(color-mode)"
      },
      {
        "command": "previewEdit.preview.toggleFullScreen",
        "title": "Toggle Full-Screen Preview",
        "category": "PreviewEdit",
        "icon": "$(screen-full)"
      },
      {
        "command": "previewEdit.preview.exitFullScreen",
        "title": "Exit Full-Screen Preview",
        "category": "PreviewEdit",
        "icon": "$(screen-normal)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "previewEdit.exportDocx",
          "when": "editorLangId == markdown"
        },
        {
          "command": "previewEdit.exportPdf",
          "when": "editorLangId == markdown && isWorkspaceTrusted"
        },
        {
          "command": "previewEdit.exportHtml",
          "when": "editorLangId == markdown"
        },
        {
          "command": "previewEdit.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "previewEdit.openPreviewToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "previewEdit.preview.toggleFullScreen",
          "when": "activeWebviewPanelId == 'markdown.preview' || previewEdit.previewFullScreen"
        },
        {
          "command": "previewEdit.preview.exitFullScreen",
          "when": "false"
        },
        {
          "command": "previewEdit.openEditPreview",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/context": [
        {
          "submenu": "previewEdit.export",
          "when": "editorLangId == markdown",
          "group": "navigation@90"
        },
        {
          "command": "previewEdit.openEditPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@91"
        }
      ],
      "previewEdit.export": [
        {
          "command": "previewEdit.exportDocx",
          "group": "1_export@1"
        },
        {
          "command": "previewEdit.exportPdf",
          "when": "isWorkspaceTrusted",
          "group": "1_export@2"
        },
        {
          "command": "previewEdit.exportHtml",
          "group": "1_export@3"
        }
      ],
      "editor/title": [
        {
          "command": "previewEdit.openPreview",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation@0"
        },
        {
          "command": "previewEdit.openPreviewToSide",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation@0"
        },
        {
          "command": "previewEdit.openEditPreview",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation@0"
        },
        {
          "command": "previewEdit.preview.decreaseFontSize",
          "when": "activeWebviewPanelId == 'markdown.preview'",
          "group": "navigation@1"
        },
        {
          "command": "previewEdit.preview.increaseFontSize",
          "when": "activeWebviewPanelId == 'markdown.preview'",
          "group": "navigation@2"
        },
        {
          "command": "previewEdit.preview.toggleTheme",
          "when": "activeWebviewPanelId == 'markdown.preview'",
          "group": "navigation@3"
        },
        {
          "command": "previewEdit.preview.toggleFullScreen",
          "when": "activeWebviewPanelId == 'markdown.preview' && !previewEdit.previewFullScreen",
          "group": "navigation@4"
        },
        {
          "command": "previewEdit.preview.exitFullScreen",
          "when": "activeWebviewPanelId == 'markdown.preview' && previewEdit.previewFullScreen",
          "group": "navigation@4"
        }
      ]
    },
    "submenus": [
      {
        "id": "previewEdit.export",
        "label": "PreviewEdit: Export"
      }
    ],
    "configuration": {
      "title": "Markdown PreviewEdit",
      "properties": {
        "previewEdit.preview.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the VS Code colour theme.",
            "Always show the preview light.",
            "Always show the preview dark."
          ],
          "description": "Colour theme of the Markdown preview. Exports are always light."
        },
        "previewEdit.mermaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render ```mermaid code blocks as diagrams in the preview and in exports."
        },
        "previewEdit.export.openAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "Open the exported file with its default application after export."
        },
        "previewEdit.export.browserPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to Microsoft Edge, Google Chrome or Chromium used for PDF export. Leave empty to detect an installed browser automatically."
        },
        "previewEdit.export.pdf.format": {
          "type": "string",
          "default": "A4",
          "enum": [
            "A4",
            "A3",
            "A5",
            "Letter",
            "Legal"
          ],
          "description": "Paper size for PDF export."
        },
        "previewEdit.export.pdf.margin": {
          "type": "string",
          "default": "20mm",
          "description": "Page margin for PDF export (CSS length, e.g. 20mm or 0.75in)."
        }
      }
    },
    "keybindings": [
      {
        "command": "previewEdit.preview.increaseFontSize",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "command": "previewEdit.preview.increaseFontSize",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "command": "previewEdit.preview.decreaseFontSize",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "command": "previewEdit.preview.decreaseFontSize",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "command": "previewEdit.preview.resetFontSize",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "command": "previewEdit.preview.resetFontSize",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'markdown.preview'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node esbuild.mjs --tests && node --test \"test-output/*.test.js\"",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "1.1.2",
    "docx": "9.8.0",
    "katex": "0.18.9",
    "markdown-it": "14.3.2",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-container": "4.0.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "mermaid": "12.0.0",
    "puppeteer-core": "25.12.0",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "2.16.1",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
